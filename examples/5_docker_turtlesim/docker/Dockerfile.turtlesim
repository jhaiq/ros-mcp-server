# AGIROS loong (ROS 2 Humble-generation compatible) with Turtlesim
FROM ubuntu:22.04

ENV ROS_DISTRO=loong
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# Add the official AGIROS 25.12 LTS repo
RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg \
    && curl -fsSL http://repo.agiros.org.cn/debrepo/agiros/ubuntu2204lts/2512/agiros.gpg \
       | gpg --dearmor -o /usr/share/keyrings/agiros-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/agiros-archive-keyring.gpg] http://repo.agiros.org.cn/debrepo/agiros/ubuntu2204lts/2512 jammy main" \
       > /etc/apt/sources.list.d/agiros.list

# Install turtlesim and rosbridge packages
RUN apt-get update && apt-get install -y \
    agiros-loong-turtlesim \
    agiros-loong-rosbridge-suite \
    agiros-loong-ros2launch \
    agiros-loong-ros2run \
    && rm -rf /var/lib/apt/lists/*

# Auto-source AGIROS loong environment in container shell
RUN echo "source /opt/agiros/loong/setup.bash" >> ~/.bashrc

# Set working directory
WORKDIR /ros2_ws

# Default command to keep container running
CMD ["/bin/bash"]
